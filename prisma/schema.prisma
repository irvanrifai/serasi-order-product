// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  username String  @id @db.Char(100)
  password String  @db.Char(100)
  name     String  @db.Char(100)
  token    String? @db.Char(100)

  contacts Contact[]

  @@map("users")
}

model Contact {
  id         Int     @id @default(autoincrement())
  first_name String  @db.Char(100)
  last_name  String? @db.Char(100)
  email      String? @db.Char(200)
  phone      String? @db.Char(20)
  username   String  @db.Char(100)

  user User @relation(fields: [username], references: [username])

  addresses Address[]

  @@map("contacts")
}

model Address {
  id          Int     @id @default(autoincrement())
  street      String? @db.Char(255)
  city        String? @db.Char(100)
  province    String? @db.Char(100)
  country     String  @db.Char(100)
  postal_code String  @db.Char(10)
  contact_id  Int

  contact Contact @relation(fields: [contact_id], references: [id])

  @@map("addresses")
}
